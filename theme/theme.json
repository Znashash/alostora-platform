{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "primary", "color": "#14315e", "name": "Alostora Navy" },
				{ "slug": "primary-dark", "color": "#0a1428", "name": "Deep Navy" },
				{ "slug": "secondary", "color": "#2c6fbf", "name": "Alostora Blue" },
				{ "slug": "accent", "color": "#f39019", "name": "Alostora Orange" },
				{ "slug": "accent-light", "color": "#f5a623", "name": "Amber" },
				{ "slug": "base", "color": "#ffffff", "name": "White" },
				{ "slug": "surface", "color": "#f5f7fa", "name": "Surface" },
				{ "slug": "surface-alt", "color": "#eef2f7", "name": "Surface Alt" },
				{ "slug": "contrast", "color": "#111c30", "name": "Ink" },
				{ "slug": "muted", "color": "#6b7280", "name": "Muted" },
				{ "slug": "border", "color": "#e2e8f0", "name": "Border" }
			],
			"gradients": [
				{
					"slug": "brand-hero",
					"gradient": "linear-gradient(135deg, #0a1428 0%, #14315e 55%, #1c4a86 100%)",
					"name": "Hero Navy"
				},
				{
					"slug": "brand-accent",
					"gradient": "linear-gradient(135deg, #f39019 0%, #f5a623 100%)",
					"name": "Accent Amber"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "IBM Plex Sans Arabic",
					"fontFamily": "\"IBM Plex Sans Arabic\", \"Segoe UI\", Tahoma, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Sans Arabic",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-arabic-400.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Sans Arabic",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-arabic-500.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Sans Arabic",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-arabic-600.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Sans Arabic",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-arabic-700.woff2" ]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Tajawal",
					"fontFamily": "\"Tajawal\", \"IBM Plex Sans Arabic\", \"Segoe UI\", Tahoma, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Tajawal",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/tajawal-500.woff2" ]
						},
						{
							"fontFamily": "Tajawal",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/tajawal-700.woff2" ]
						},
						{
							"fontFamily": "Tajawal",
							"fontWeight": "800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/tajawal-800.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": { "min": "0.8125rem", "max": "0.9375rem" } },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": { "min": "0.9375rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "X-Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "2X-Large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3rem" } },
				{ "slug": "display", "name": "Display", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"customSpacingSize": true,
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "Small", "size": "1rem" },
				{ "slug": "40", "name": "Medium", "size": "1.5rem" },
				{ "slug": "50", "name": "Large", "size": "2.5rem" },
				{ "slug": "60", "name": "XL", "size": "4rem" },
				{ "slug": "70", "name": "2XL", "size": "6rem" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"radius": {
				"sm": "8px",
				"md": "14px",
				"lg": "22px",
				"pill": "999px"
			},
			"shadow": {
				"card": "0 12px 30px rgba(20, 49, 94, 0.10)",
				"raised": "0 20px 45px rgba(20, 49, 94, 0.16)"
			},
			"transition": {
				"base": "0.25s cubic-bezier(0.4, 0, 0.2, 1)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 5vw, 2.5rem)",
				"right": "clamp(1rem, 5vw, 2.5rem)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				},
				"color": { "text": "var(--wp--preset--color--primary)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "fontWeight": "800" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "var(--wp--custom--radius--pill)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700" },
				":hover": { "color": { "background": "var(--wp--preset--color--accent-light)" } }
			}
		}
	},
	"customTemplates": [
		{ "name": "page-full-width", "title": "Full Width (Elementor Canvas)", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
